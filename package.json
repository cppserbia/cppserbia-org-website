{
  "name": "cppserbia.org",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "spell": "cspell --no-progress --no-summary \"**/*.{ts,tsx,md,mdx,json,yml,yaml}\"",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "next lint --fix --file",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-slot": "1.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^5.2.1",
    "gray-matter": "latest",
    "ics": "^3.12.1",
    "lucide-react": "^0.454.0",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "latest",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@coopkit/meetup": "^0.3.0",
    "@cspell/dict-cpp": "^7.2.0",
    "@cspell/dict-fullstack": "^3.2.9",
    "@cspell/dict-git": "^3.1.1",
    "@cspell/dict-markdown": "^2.0.18",
    "@cspell/dict-scientific-terms-us": "^3.1.2",
    "@cspell/dict-shell": "^1.2.0",
    "@cspell/dict-terraform": "^1.1.4",
    "@github/copilot": "^1.0.103",
    "@github/copilot-sdk": "^0.1.32",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "citty": "^0.2.2",
    "cspell": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "linkedom": "^0.18.14",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8",
    "vitest": "^4.1.12"
  }
}
